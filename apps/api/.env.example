# Copy to .env and fill in. Never commit real keys.
#
# Postgres. docker-compose maps the container's 5432 to host port 5433.
DATABASE_URL=postgresql+psycopg://kamusi:kamusi123@localhost:5433/kamusi
# Key required by /admin/* routes in the X-API-Key header. ADMIN_API_KEY wins
# when both are set (see app/deps.py).
API_KEY=dev-api-key
ADMIN_API_KEY=dev-api-key
# Only needed by the offline AI definition generator in tools/ai_defs.
OPENAI_API_KEY=
# Comma-separated or JSON array. Must include the admin app's origin.
CORS_ORIGINS=http://localhost:3000
