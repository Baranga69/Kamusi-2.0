# Copy to .env.local and fill in.
#
# Base URL of the Kamusi API. Read server-side at request time by the route
# handlers in app/api/*, so a single build works across environments.
KAMUSI_API_BASE_URL=http://localhost:8000
# Optional fallback when KAMUSI_API_BASE_URL is unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
