# Copy to .env.local and fill in. Never commit real keys.
#
# Base URL of the Kamusi API. Used by server-side code and the review proxy.
KAMUSI_API_BASE_URL=http://localhost:8000
# Optional browser-visible fallback when KAMUSI_API_BASE_URL is unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side admin key for the /api/review proxy routes. Must match the API's
# ADMIN_API_KEY. Kept server-side so it never reaches the browser.
ADMIN_API_KEY=replace-me
# Optional separate key for a deployed API.
PROD_ADMIN_API_KEY=replace-me
